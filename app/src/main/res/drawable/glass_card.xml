<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 背景半透明玻璃效果 -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#6616213E"/> <!-- 深蓝半透明 -->
            <corners android:radius="20dp"/> <!-- 圆角 -->
        </shape>
    </item>

    <!-- 霓虹蓝紫边框 -->
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="2dp" android:color="#AA00C9FF"/> <!-- 霓虹蓝边框 -->
            <corners android:radius="20dp"/>
        </shape>
    </item>

    <!-- 玻璃反光高光层 -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="#33FFFFFF"
                android:endColor="#00FFFFFF"/>
            <corners android:radius="20dp"/>
        </shape>
    </item>
</layer-list>
