<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="20dp"
    android:background="@drawable/gradient_bg">

    <!-- 半透明卡片 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="@drawable/glass_card"
        android:elevation="8dp"
        android:layout_centerInParent="true"
        android:animateLayoutChanges="true">

        <!-- 日期 & 时间 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:padding="8dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_calender"/>

            <TextView
                android:id="@+id/item_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="@color/white"
                android:textSize="16sp"
                tools:text="2024.10.16"/>
            <TextView
                android:id="@+id/item_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="@color/white"
                android:textSize="16sp"
                tools:text="10:19:15"/>
        </LinearLayout>

        <!-- 发信人 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="8dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_sender"/>

            <TextView
                android:id="@+id/item_sender"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="@color/neon_blue"
                android:textSize="16sp"
                tools:text="13812345678"/>
        </LinearLayout>

        <!-- 短信内容 -->
        <TextView
            android:id="@+id/item_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:shadowColor="@color/neon_purple"
            android:shadowDx="2"
            android:shadowDy="2"
            android:shadowRadius="6"
            tools:text="哈哈哈哈哈哈哈哈哈"/>

        <!-- 类型 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:padding="8dp">

            <ImageView
                android:id="@+id/ic_warning"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_warning"/>

            <TextView
                android:id="@+id/item_type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="@color/neon_red"
                android:textStyle="bold"
                android:textSize="18sp"
                tools:text="诈骗"/>
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
