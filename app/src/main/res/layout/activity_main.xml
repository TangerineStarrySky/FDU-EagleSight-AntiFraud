<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/animated_gradient"
    tools:context=".MainActivity">

    <ImageView
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:src="@drawable/ic_launcher_round"
        android:layout_marginTop="30dp"
        android:layout_marginLeft="30dp"
        android:elevation="12dp" />
    <!-- 霓虹标题 -->
    <TextView
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="鹰眼智能识别"
        android:textSize="36sp"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:layout_gravity="center_horizontal|top"
        android:layout_marginLeft="20dp"
        android:paddingTop="40dp"
        android:shadowColor="@color/white"
        android:shadowDx="8"
        android:shadowDy="8"
        android:shadowRadius="15" />

    <!-- 中心悬浮卡片 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:background="@drawable/glass_card"
        android:padding="24dp"
        android:elevation="10dp"
        android:layout_margin="20dp">

        <!-- 开启分析按钮 -->
        <Button
            android:id="@+id/status_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="开启分析"
            android:textSize="20sp"
            android:textColor="@color/white"
            android:background="@drawable/neon_button" />

        <!-- 短信输入 -->
        <EditText
            android:id="@+id/input_sms"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:hint="请输入短信内容"
            android:textColorHint="@color/white"
            android:background="@drawable/neon_input"
            android:textColor="@color/white"
            android:textSize="17sp"
            android:padding="10dp"
            android:layout_marginTop="16dp" />

        <!-- 检测按钮 -->
        <Button
            android:id="@+id/btn_detect"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="开始检测"
            android:textSize="20sp"
            android:textColor="@color/white"
            android:background="@drawable/neon_button"
            android:layout_marginTop="16dp" />

        <!-- 检测结果 -->
        <TextView
            android:id="@+id/output_result"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:background="@drawable/neon_input"
            android:textColor="@color/white"
            android:textSize="17sp"
            android:padding="8dp"
            android:text="这里显示检测结果"
            android:gravity="center|left"
            android:layout_marginTop="16dp" />

    </LinearLayout>

    <!-- 悬浮按钮菜单 -->
    <ImageView
        android:id="@+id/btn_menu"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:src="@drawable/ic_menu"
        android:layout_gravity="bottom|end"
        android:layout_margin="20dp"
        android:background="@drawable/neon_button"
        android:elevation="12dp" />

    <!-- 功能按钮：初始隐藏 -->
    <ImageView
        android:id="@+id/btn_info"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:src="@android:drawable/ic_menu_info_details"
        android:layout_gravity="bottom|end"
        android:layout_margin="25dp"
        android:background="@drawable/neon_button"
        android:elevation="10dp"
        android:visibility="gone"/>

    <ImageView
        android:id="@+id/btn_help"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:src="@android:drawable/ic_menu_help"
        android:layout_gravity="bottom|end"
        android:layout_margin="25dp"
        android:background="@drawable/neon_button"
        android:elevation="10dp"
        android:visibility="gone"/>

    <ImageView
        android:id="@+id/btn_setting"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:src="@android:drawable/ic_menu_preferences"
        android:layout_gravity="bottom|end"
        android:layout_margin="25dp"
        android:background="@drawable/neon_button"
        android:elevation="10dp"
        android:visibility="gone"/>

    <ImageView
        android:id="@+id/btn_learning"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:src="@android:drawable/ic_menu_view"
        android:layout_gravity="bottom|end"
        android:layout_margin="25dp"
        android:background="@drawable/neon_button"
        android:elevation="10dp"
        android:visibility="gone"/>

    <ImageView
        android:id="@+id/btn_history"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:src="@android:drawable/ic_menu_recent_history"
        android:layout_gravity="bottom|end"
        android:layout_margin="25dp"
        android:background="@drawable/neon_button"
        android:elevation="10dp"
        android:visibility="gone"/>

    <ImageView
        android:id="@+id/btn_feedback"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:src="@android:drawable/ic_menu_upload"
        android:layout_gravity="bottom|end"
        android:layout_margin="25dp"
        android:background="@drawable/neon_button"
        android:elevation="10dp"
        android:visibility="gone"/>

    <ImageView
        android:id="@+id/btn_share"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:src="@android:drawable/ic_menu_share"
        android:layout_gravity="bottom|end"
        android:layout_margin="25dp"
        android:background="@drawable/neon_button"
        android:elevation="10dp"
        android:visibility="gone"/>
</FrameLayout>
